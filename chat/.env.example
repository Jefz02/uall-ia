# URL do servidor Socket.IO
# Em desenvolvimento local (socket rodando via npm run dev ou docker)
VITE_SOCKET_URL=http://localhost:3001

# URL do agente Fastify (para endpoints admin)
VITE_AGENT_URL=http://localhost:3000

# ─── Identidade Visual ────────────────────────────────────────────────────────
# Nome da marca exibido na interface (header do chat e painel admin)
VITE_BRAND_NAME=U-all Solutions

# Tagline exibida abaixo do nome no header do chat
VITE_BRAND_TAGLINE=Wi-Fi Marketing e captação de dados

# ─── Fontes (nomes de famílias do Google Fonts) ───────────────────────────────
# Sobrescreve as CSS variables --font-sans, --font-serif, --font-mono em runtime
VITE_FONT_SANS=Inter
VITE_FONT_SERIF=Inter
VITE_FONT_MONO=JetBrains Mono
