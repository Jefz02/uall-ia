# ============================================================
# LLM — OpenAI
# ============================================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ============================================================
# Supabase (self-hosted via Docker)
# ============================================================
# URL do gateway nginx — dentro do Docker é http://gateway:8000
# Para scripts locais fora do Docker use http://localhost:8000
SUPABASE_URL=http://localhost:8000

# JWT secret compartilhado entre PostgREST e o agente (mín. 32 chars)
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long

# Service Role Key — JWT assinado com o JWT_SECRET acima.
# Se mudar o JWT_SECRET, gere um novo em:
# https://supabase.com/docs/guides/self-hosting/docker#generate-api-keys
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UtZGVtbyIsImlhdCI6MTY0MTc2OTIwMCwiZXhwIjoxNzk5NTM1NjAwfQ.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q

# ============================================================
# PostgreSQL (somente necessário se alterar os defaults)
# ============================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# ============================================================
# Redis
# ============================================================
# Docker (dentro do container): redis://redis:6379
# Local (npm run console):      redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ============================================================
# LangSmith — tracing
# ============================================================
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=uall-ia-agent

# ============================================================
# App
# ============================================================
PORT=3000
NODE_ENV=development
SOCKET_PORT=3001
SUPABASE_PORT=8000

# WhatsApp via Whaileys (true = ativa; false = só REST)
WHATSAPP_ENABLED=false

# ============================================================
# Webhooks de ferramentas
# ============================================================
# Local (npm run console / npm run dev):  http://localhost:3001/tools/lead
# Docker (dentro do container):           http://host.docker.internal:3001/tools/lead
LEAD_URL=http://host.docker.internal:3001/tools/lead
ESCALATION_URL=http://host.docker.internal:3001/tools/escalation

# ============================================================
# Rate Limiting
# ============================================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_MESSAGES=10

# ============================================================
# Cache TTL
# ============================================================
RESPONSE_CACHE_TTL_SECONDS=3600

# ============================================================
# Admin Panel
# ============================================================
ADMIN_PASSWORD=changeme_min8chars
ADMIN_JWT_SECRET=your-admin-jwt-secret-at-least-32-characters!!

# ============================================================
# Notificação WhatsApp para o time comercial (número interno)
# ============================================================
# Formato: código do país + DDD + número (sem + ou espaços), ex: 5511999999999
WHATSAPP_NOTIFY_PHONE=

# Chave hex (32 bytes = 64 chars) para criptografar a sessão WhatsApp persistida
# no banco. Gere com: openssl rand -hex 32
WA_SESSION_ENCRYPTION_KEY=

# ============================================================
# Marca
# ============================================================
BRAND_NAME=U-all Solutions
BRAND_TAGLINE=Wi-Fi Marketing e captação de dados com IA

# E-mail e WhatsApp comercial exibidos nas mensagens de escalonamento
CONTACT_EMAIL=contato@uallsolutions.com.br
CONTACT_WHATSAPP=+55 11 5200-1846
